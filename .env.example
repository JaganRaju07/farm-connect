# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# IMPORTANT: Change 'postgres' to your database username if it's different.
# IMPORTANT: Change 'your_actual_password' to your real PostgreSQL password!
DATABASE_URL=postgresql://postgres:your_actual_password@localhost:5432/farmconnect

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# This secret is used to sign the JWT tokens. Do not share it!
JWT_SECRET=my_super_secret_jwt_key_farm_connect_2024
JWT_EXPIRES_IN=30d

# ==========================================
# SMS SERVICE (Fast2SMS)
# ==========================================
FAST2SMS_API_KEY=your-fast2sms-api-key
SMS_SENDER_ID=FARMCNT