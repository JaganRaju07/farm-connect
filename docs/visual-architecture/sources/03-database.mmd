%% --------------------------------------------------------
%% 2. GEOSPATIAL PROXIMITY ENGINE & HAVERSINE FORMULA
%% --------------------------------------------------------
flowchart TD
    subgraph ClientCoordinates ["Consumer Hardware GPS"]
        Coords["lat1 = 12.9716, lon1 = 77.5946<br/>radius = 30 km"]
    end

    subgraph DatabaseExecution ["PostgreSQL Engine: calculate_distance_km()"]
        ConvertRad["Convert lat/lon to Radians:<br/>rad(x) = x * pi / 180"]
        HaversineFormula["Haversine Formula Spherical Math:<br/>d = 2 * R * asin(sqrt(sin^2(dlat/2) + cos(lat1)*cos(lat2)*sin^2(dlon/2)))<br/>where R = 6371 km"]
        SpatialFilter["WHERE calculate_distance_km(lat1, lon1, f.latitude, f.longitude) <= radius"]
        SpatialSort["ORDER BY distance_km ASC"]
    end

    subgraph QueryOutput ["Result Set"]
        SortedProducts["List of verified farm crops sorted by nearest physical distance"]
    end

    Coords --> ConvertRad --> HaversineFormula --> SpatialFilter --> SpatialSort --> SortedProducts

%% --------------------------------------------------------
%% 3. DATABASE QUERY LIFECYCLE & POOL MANAGEMENT
%% --------------------------------------------------------
sequenceDiagram
    autonumber
    participant App as Express Request Handler
    participant Pool as pg.Pool Instance
    participant Client as Dedicated Client Connection
    participant Postgres as Supabase PostgreSQL Instance

    App->>Pool: pool.query(sql, params)
    Pool->>Client: Acquire idle client from pool (max 10)
    Client->>Postgres: Execute query over TLS 1.3
    Postgres-->>Client: Return query row results
    Client->>Pool: Release client back to idle pool
    Pool-->>App: Return rows array to handler

    Note over Pool,Postgres: In case of unhandled idle disconnection
    Postgres-xPool: Idle connection dropped
    Pool->>Pool: pool.on('error') logs event, destroys client
