%% --------------------------------------------------------
%% 3. ROUTING & ROLE-BASED NAVIGATION
%% --------------------------------------------------------
stateDiagram-v2
    [*] --> GuestUnauthenticated

    GuestUnauthenticated --> BrowsePublic: Visit / or /marketplace
    GuestUnauthenticated --> LoginFlow: Visit /login or /register

    state LoginFlow {
        EnterPhone --> RequestOTP: POST /auth/send-otp
        RequestOTP --> EnterCode: Fast2SMS Delivery
        EnterCode --> VerifyCode: POST /auth/verify-otp
    }

    LoginFlow --> RoleEvaluation: JWT Issued (role: farmer | consumer | admin)

    state RoleEvaluation {
        IsConsumer --> ConsumerRoutes: Role == 'consumer'
        IsFarmer --> FarmerRoutes: Role == 'farmer'
        IsAdmin --> AdminRoutes: Role == 'admin'
    }

    state ConsumerRoutes {
        /marketplace --> /product/:id
        /product/:id --> /cart
        /cart --> /checkout
        /checkout --> /orders: Order Confirmed
    }

    state FarmerRoutes {
        /farmer/dashboard --> /farmer/products: Manage Inventory
        /farmer/dashboard --> /farmer/orders: Fulfill Orders
    }

    state AdminRoutes {
        /admin --> VerificationTable: Approve Farmers
        /admin --> TelemetryCharts: View GMV & Order Volume
    }

%% --------------------------------------------------------
%% 4. AUTHENTICATION & STATE MANAGEMENT
%% --------------------------------------------------------
sequenceDiagram
    autonumber
    actor User as Client Browser
    participant AC as AuthContext.tsx
    participant LS as localStorage
    participant API as api.ts (Axios)
    participant Back as /api/v1/auth

    User->>AC: login(token, user, role)
    AC->>LS: setItem('auth_token', token)
    AC->>LS: setItem('auth_user', JSON.stringify(user))
    AC->>LS: setItem('auth_role', role)
    AC->>API: axios.defaults.headers.common['Authorization'] = 'Bearer ' + token
    AC-->>User: State updated: isAuthenticated = true

    Note over User,Back: On Page Reload (Mount Phase)
    AC->>LS: getItem('auth_token')
    alt Token Found
        AC->>Back: POST /refresh-token or GET /profile
        Back-->>AC: HTTP 200 (Valid User)
        AC-->>User: Rehydrate user state
    else Token Missing or Expired
        AC->>LS: clearAuth()
        AC-->>User: Redirect to /login
    end

%% --------------------------------------------------------
%% 5. API INTEGRATION & AXIOS INTERCEPTOR PIPELINE
%% --------------------------------------------------------
flowchart TD
    ClientRequest["Component triggers API call (e.g. api.get('/products'))"]
    
    subgraph RequestInterceptor ["Axios Request Interceptor"]
        CheckToken{"Is 'auth_token' present in localStorage?"}
        AttachHeader["Attach Header:<br/>Authorization: Bearer <token>"]
        PassClean["Pass request without auth header"]
    end

    subgraph NetworkWire ["HTTP Transmission"]
        RenderServer["Render Backend Gateway (Node.js/Express)"]
    end

    subgraph ResponseInterceptor ["Axios Response Interceptor"]
        CheckStatus{"Inspect HTTP Status Code"}
        Status2xx["2xx OK: Return response.data to caller"]
        Status401["401 Unauthorized: Clear token, redirect to /login"]
        Status403["403 Forbidden: Toast error 'Permission Denied'"]
        Status5xx["5xx Server Error: Toast error 'Service Unavailable'"]
    end

    ClientRequest --> CheckToken
    CheckToken -- Yes --> AttachHeader --> RenderServer
    CheckToken -- No --> PassClean --> RenderServer
    RenderServer --> CheckStatus
    CheckStatus --> Status2xx
    CheckStatus --> Status401
    CheckStatus --> Status403
    CheckStatus --> Status5xx
