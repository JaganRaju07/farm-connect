%% --------------------------------------------------------
%% 3. ENDPOINT TO IMPLEMENTATION MATRIX
%% --------------------------------------------------------
flowchart LR
    subgraph AuthEndpoints ["/api/v1/auth"]
        A1["POST /send-otp"] --> AC1["authController.sendOTP()"] --> DB_OTP["otp_store + Fast2SMS"]
        A2["POST /verify-otp"] --> AC2["authController.verifyOTP()"] --> DB_USR["farmers/consumers + JWT"]
    end

    subgraph ProductEndpoints ["/api/v1/products"]
        P1["GET / (Search)"] --> PC1["productController.searchNearbyProducts()"] --> DB_SPATIAL["calculate_distance_km()"]
        P2["POST /create"] --> PC2["productController.createProduct()"] --> DB_PROD["products (INSERT)"]
    end

    subgraph OrderEndpoints ["/api/v1/consumers"]
        O1["POST /orders"] --> OC1["consumerController.createOrder()"] --> DB_ORD["orders (JSONB line items)"]
        O2["GET /orders"] --> OC2["consumerController.getConsumerOrders()"] --> DB_FETCH["orders JOIN farmers"]
    end
